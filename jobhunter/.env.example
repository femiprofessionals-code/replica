# JobHunter environment. Copy to .env (or set as GitHub Actions secrets).

# --- Documents (optional). Without this, copy falls back to templates. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Google Sheets tracker (optional; falls back to local CSV). ---
# Share the sheet with the service account email as an Editor.
JOBHUNTER_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# or: GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
JOBHUNTER_CSV=jobhunter_tracker.csv

# --- Report delivery (choose Resend OR SMTP). ---
REPORT_TO=femiprofessionals@gmail.com
REPORT_FROM=JobHunter <onboarding@resend.dev>
RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Auto-submit guard. Only email-apply postings are ever auto-sent, and
# only when this is exactly "true". Everything else stays manual. ---
SEND_APPLICATIONS=false

# --- Paths ---
JOBHUNTER_CONFIG=config.yaml
JOBHUNTER_CV=cv.md
