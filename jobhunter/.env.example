# JobHunter environment. Copy to .env (or set as GitHub Actions secrets).

# --- Documents (optional). Without this, copy falls back to templates. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Job sources (free keys). Location-aware sources need these; without
# them that source is skipped and others still run. ---
# Adzuna: https://developer.adzuna.com/  (all industries, remote + radius + salary)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# USAJobs: https://developer.usajobs.gov/  (federal health/Medicaid/compliance)
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# --- Google Sheets tracker (optional; falls back to local CSV). ---
# Share the sheet with the service account email as an Editor.
JOBHUNTER_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# or: GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
JOBHUNTER_CSV=jobhunter_tracker.csv

# --- Report delivery (choose Resend OR SMTP). ---
# For Gmail SMTP, use a Gmail APP PASSWORD (Google Account > Security > App
# passwords), never the account password. Never commit any password.
REPORT_TO=
REPORT_FROM=JobHunter <onboarding@resend.dev>
RESEND_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Auto-submit guard. Only email-apply postings are ever auto-sent, and
# only when this is exactly "true". Everything else stays manual. ---
SEND_APPLICATIONS=false

# --- Paths (default to the committed profile) ---
JOBHUNTER_CONFIG=profiles/jummy/config.yaml
JOBHUNTER_CV=profiles/jummy/cv.md
