# ---------------------------------------------------------------------------
# ClearPoints environment. Copy to .env.local and fill in.
# Never expose service-role or secret keys to the client.
# ---------------------------------------------------------------------------

# Public Supabase config (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role (used by seed scripts / admin tasks only)
SUPABASE_SERVICE_ROLE_KEY=

# App base URL, used for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Award data provider selection: mock | seatsaero
AWARD_PROVIDER=mock

# seats.aero Partner API (Phase 2+, not used while AWARD_PROVIDER=mock)
SEATS_AERO_API_KEY=
SEATS_AERO_BASE_URL=https://seats.aero/partnerapi

# Deterministic seed for the mock provider so demos are reproducible
MOCK_SEED=clearpoints-phase1
